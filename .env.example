# Copy to apps/web/.env.local for local development. Never commit real values.

# --- AI provider (OpenAI-compatible: OpenAI, Groq, Together, OpenRouter) ---
AI_API_KEY=
# e.g. https://api.groq.com/openai/v1 (leave empty for OpenAI)
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# --- Base resume (the route needs one of these) ---
# Plain-text resume; easiest option on Vercel
RESUME_TEXT=
# Or a PDF path; relative paths resolve from the repo root
RESUME_PDF_PATH=Aman_Behl_ATS_Resume.pdf
# Name printed on generated PDFs
CANDIDATE_NAME=Aman Behl

# --- /api/ai-update protection (all optional) ---
# Extra allowed origins, comma-separated. The production domain and Vercel
# deployment URLs are always allowed; localhost is allowed outside production.
ALLOWED_ORIGINS=
# Requests per IP per window (default 10 per hour)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000
